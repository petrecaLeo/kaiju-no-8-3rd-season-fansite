---
import './SectionPlaceholder.css';

interface Props {
  label: string;
  fullBleed?: boolean;
}

const { label, fullBleed = false } = Astro.props;
---

<div class:list={['section-placeholder', { 'section-placeholder--full-bleed': fullBleed }]}>
  <p class="section-placeholder__label">{label}</p>
</div>
