---
import LanguageSwitcher from '@/components/layout/LanguageSwitcher/LanguageSwitcher.astro';
import { ANCHORS } from '@/config/anchors';
import type { Locale } from '@/i18n/config';

import './SiteHeader.css';

interface Props {
  locale: Locale;
  languageSwitcherLabel: string;
}

const { locale, languageSwitcherLabel } = Astro.props;
---

<header id={ANCHORS.top} class="site-header" tabindex="-1">
  <LanguageSwitcher locale={locale} label={languageSwitcherLabel} />
</header>
